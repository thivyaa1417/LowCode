				Monthly_Rent as "Monthly Rent"
				Status
				Capacity
			)
		}
	}
	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Occupancy by Room Type'\n\n\ttype = 'Column'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Room'\n\txfield = 'Room_Type'\n\tyfields = 'count:Room_Number'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Payments by Status'\n\n\ttype = 'Column'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Payment'\n\txfield = 'Status'\n\tyfields = 'count:Month_field'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Complaints by Status'\n\n\ttype = 'Column'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Complaint'\n\txfield = 'Status'\n\tyfields = 'count:ID'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Pending_Payments'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Validate_Allocation as "Validate Allocation"
			{
				type =  form
				form = Allocation

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validation 1: check-out date must not be earlier than check-in date
										if(input.Check_Out_Date != null && input.Check_Out_Date < input.Check_In_Date)
										{
											alert "Check-out date cannot be earlier than the check-in date.";
											cancel submit;
										}
										// Validation 2: block the allocation if the room is not Available or is already full
										roomRec = Room[ID == input.Room];
										if(roomRec.Status != "Available")
										{
											alert "This room cannot be allocated. Room status is: " + roomRec.Status;
											cancel submit;
										}
										currentCount = Allocation[Room == input.Room && Check_Out_Date == null].count();
										if(currentCount >= roomRec.Capacity)
										{
											alert "This room is already full. Capacity: " + roomRec.Capacity;
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Payment as "Validate Payment"
			{
				type =  form
				form = Payment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validation: payment amount must be greater than 0
										if(input.Amount_Paid <= 0)
										{
											alert "Amount paid must be greater than 0.";
											cancel submit;
										}
						)
					}
				}

			}
			Update_Room_Status as "Update Room Status"
			{
				type =  form
				form = Allocation

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// After a successful allocation: mark the room Occupied once it is full
										roomRec = Room[ID == input.Room];
										activeCount = Allocation[Room == input.Room && Check_Out_Date == null].count();
										if(activeCount >= roomRec.Capacity)
										{
											roomRec.Status="Occupied";
										}
						)
					}
				}

			}
			Complaint_Email_Alert as "Complaint Email Alert"
			{
				type =  form
				form = Complaint

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Notify the app admin (only) when a complaint is created
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"New hostel complaint: " + input.Category
											message :"A new complaint was registered. Category: " + input.Category + ". Description: " + input.Description + ". Status: " + input.Status
										]
						)
					}
				}

			}
		}

		schedule
		{
			Weekly_Rent_Due_Reminder as "Weekly Rent Due Reminder"
			{
				type =  schedule
					status = inactive
				start = "2026-11-02 09:00:00"
				frequency = weekly
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Weekly rent-due reminder sent to the app admin only
										pendingList = Payment[Status == "Pending"];
										cnt = pendingList.count();
										total = 0;
										for each  p in pendingList
										{
											total = total + ifnull(p.Balance_Due,0);
										}
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"Weekly rent due reminder"
											message :"Pending payments: " + cnt + ". Total balance due: " + total
										]
					)
					}
				}
			}
		}

		approval
		{
			Resident_Registration_App as "Resident Registration Approval"
			{
				type =  approval
				form = Resident
				display fields = [Name,Email,Phone_Number,Guardian_Name,Guardian_Phone,ID_Type,Gender]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}



	}
